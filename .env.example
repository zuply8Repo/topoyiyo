# ===================================
# content_to_social_ui Environment Variables
# ===================================
# Copy this file to .env.local for local development.
# In production (Vercel), add these in the Vercel dashboard → Settings → Environment Variables.

# ----------------
# Clerk Auth
# ----------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ----------------
# Supabase
# ----------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ----------------
# Backend API
# ----------------
# Local: http://localhost:8000/api/v1
# Production: https://yiyobackend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://yiyobackend.onrender.com/api/v1

# ----------------
# App URL (set to your Vercel deployment URL in production)
# ----------------
NEXTAUTH_URL=https://your-app.vercel.app

# ----------------
# Sentry (optional - error tracking)
# ----------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
